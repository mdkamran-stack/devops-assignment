aws_region = "us-west-2"
instances = {
  "dev-web-01" = {
    instance_type = "t3.micro"
    volume_type = "gp3"
    volume_size = 20
    iops = 3000
    key_name = "dev-key"
    environment = "Development"
    owner = "DevOps"
  }
  "test-app-01" = {
    instance_type = "t3.small"
    volume_type = "gp2"
    volume_size = 30
    key_name = "test-key"
    environment = "Testing"
    owner = "DevOps"
  }
  "stage-app-01" = {
    instance_type = "t3.medium"
    volume_type = "gp3"
    volume_size = 40
    iops = 3500
    key_name = "stage-key"
    environment = "Staging"
    owner = "Platform"
  }
  "prod-db-01" = {
    instance_type = "m5.large"
    volume_type = "io2"
    volume_size = 100
    iops = 3000
    key_name = "prod-key"
    environment = "Production"
    owner = "Database"
  }
  "prod-app-01" = {
    instance_type = "t3.large"
    volume_type = "gp3"
    volume_size = 50
    iops = 3000
    key_name = "prod-key"
    environment = "Production"
    owner = "Platform"
  }
}
